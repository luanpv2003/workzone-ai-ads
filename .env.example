# Workzone AI Ads settings. scripts/install.sh copies this file to .env and fills in the secrets for you.
# After changing .env, apply it with: ./scripts/install.sh   (or: docker compose up -d --build)

# ---- Database (PostgreSQL) ----
# Docker install: the database runs in the "db" container; only the password below is used
# (DATABASE_URL is set automatically inside Docker).
POSTGRES_PASSWORD=""
# Non-Docker install (Node + your own Postgres): the connection string.
DATABASE_URL="postgresql://ads:ads@localhost:5432/ads"

# ---- Address ----
# The address people (and Meta, and your AI) use to reach this installation, without a trailing slash.
# Used in notification links, the Meta webhook callback and the MCP endpoint.
#   On your computer: http://localhost:3000   On a server: https://ads.example.com
PUBLIC_URL="http://localhost:3000"
# Docker: port on this machine, and which interface to listen on.
# 127.0.0.1 = only this computer (or a reverse proxy on the same server). 0.0.0.0 = every network interface.
APP_PORT="3000"
APP_BIND="127.0.0.1"
# Server with HTTPS through the built-in Caddy (docker compose --profile https up -d): your domain name.
# DOMAIN="ads.example.com"
# Login cookies: "true" = sent over HTTPS only. Must match PUBLIC_URL:
#   PUBLIC_URL starts with http://  -> "false" (otherwise nobody can stay logged in, the first-run /setup included)
#   PUBLIC_URL starts with https:// -> "true"
# scripts/install.sh sets this for you from PUBLIC_URL when it is missing.
COOKIE_SECURE="false"
# "true" only when a reverse proxy in front of the app sets X-Real-IP / X-Forwarded-For (Caddy, nginx: docs/server.md);
# the login rate limit then also counts per client IP. Leave unset when the app is reached directly.
# TRUST_PROXY="true"

# ---- Branding ----
# Docker: these three are built into the page code, so re-run ./scripts/install.sh after changing them.
NEXT_PUBLIC_APP_NAME="Workzone AI Ads"
# Legal operator of this installation (you / your company), shown on the privacy and data-deletion pages.
# Review src/app/privacy/page.tsx before going live: it is a template.
NEXT_PUBLIC_OPERATOR_NAME=""
NEXT_PUBLIC_OPERATOR_SITE=""

# ---- Security ----
# Encrypts Meta / Google tokens stored in the DB. Long random string (install.sh generates one).
# NEVER change it after tokens are saved, and keep a copy with your backups: without it saved tokens cannot be read.
ENCRYPTION_KEY=""

# ---- Meta ----
META_API_VERSION="v23.0"

# ---- Built-in AI (optional) ----
# Claude API key from console.anthropic.com. You can also paste it later in the app:
# System settings -> Claude AI. Leave empty if you only use your own AI through MCP (docs/ai.md).
ANTHROPIC_API_KEY=""
# No API key? The built-in AI can run on your own Claude subscription instead: paste a `claude setup-token`
# token in System settings -> Claude AI (docs/ai.md). Force "cli" or "api" (default: API if a key is set).
# CLAUDE_PROVIDER="cli"
# CLAUDE_MODEL="opus"
# CLAUDE_CLI_PATH="/usr/local/bin/claude"

# ---- Background worker ----
# Client jobs run in parallel (default 3).
# WORKER_CONCURRENCY="3"

# ---- Backups (scripts/backup.sh, non-Docker; Docker: see docs/install.md) ----
# BACKUP_DIR="$HOME/backup/ads"
# Off-server copy via rclone, e.g. "s3:my-bucket/ads-backup".
# BACKUP_REMOTE=""

# Prebuilt Docker images: set to the image name without the -app / -worker suffix (for example ghcr.io/workzone-vn/workzone-ai-ads)
# and install.sh downloads them instead of building. Prebuilt images use the default app name; leave empty to build with your own NEXT_PUBLIC_* names.
WZ_IMAGE=""
WZ_TAG="latest"
